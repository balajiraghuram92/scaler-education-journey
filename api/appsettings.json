{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExerciseExecution": {
    "ExercisesRoot": "",
    "WorkspaceRoot": "",
    "RunnerImage": "neuralascent-java-runner:dev",
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "MavenCacheVolume": "neuralascent-maven-cache",
    "MaxConcurrentExecutions": 2,
    "MaxFileBytes": 131072,
    "MaxSubmissionBytes": 262144,
    "MaxOutputBytes": 65536,
    "MaxExecutionSeconds": 120,
    "ExecutionStartupGraceSeconds": 15,
    "MemoryLimitBytes": 805306368,
    "NanoCpus": 1000000000,
    "PidsLimit": 128,
    "ContainerCleanupGraceSeconds": 5
  },
  "Auth": {
    "JwtIssuer": "neuralascent",
    "JwtAudience": "neuralascent-app",
    "JwtExpiryMinutes": 720,
    "CookieName": "na_auth",
    "MinPasswordLength": 10
  },
  "Email": {
    "SmtpPort": 587,
    "UseSsl": true,
    "FromAddress": "noreply@neuralascent.top",
    "FromDisplayName": "Neuralascent"
  },
  "LlamaApi": {
    "BaseUrl": "https://api.llama.com/v1/",
    "Model": "Llama-4-Maverick-17B-128E-Instruct-FP8",
    "TimeoutSeconds": 30,
    "MaxHistoryMessages": 10,
    "MaxContextCharacters": 6000,
    "PricePerMillionInputTokensUsd": 0,
    "PricePerMillionOutputTokensUsd": 0
  },
  "Budget": {
    "DailyCapUsd": 2.00,
    "MaxDailyRequests": 500
  },
  "AllowedHosts": "*"
}
