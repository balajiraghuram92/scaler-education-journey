{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExerciseExecution": {
    "ExercisesRoot": "",
    "WorkspaceRoot": "",
    "RunnerImage": "neuralascent-java-runner:dev",
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "MavenCacheVolume": "neuralascent-maven-cache",
    "MaxConcurrentExecutions": 2,
    "MaxFileBytes": 131072,
    "MaxSubmissionBytes": 262144,
    "MaxOutputBytes": 65536,
    "MaxExecutionSeconds": 120,
    "ExecutionStartupGraceSeconds": 15,
    "MemoryLimitBytes": 805306368,
    "NanoCpus": 1000000000,
    "PidsLimit": 128,
    "ContainerCleanupGraceSeconds": 5
  },
  "AllowedHosts": "*"
}
