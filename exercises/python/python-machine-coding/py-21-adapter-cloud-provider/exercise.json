  "evidence": [
    {
      "id": "aws-adapter-maps-provider-response",
      "label": "AWSCloudAdapter maps the AWS response to a domain Connection",
      "testMethod": "test_aws_adapter_maps_provider_response"
    },
    {
      "id": "google-adapter-maps-provider-response",
      "label": "GoogleCloudAdapter maps the Google response to a domain Connection",
      "testMethod": "test_google_adapter_maps_provider_response"
    },
    {
      "id": "non-success-status-maps-to-failure",
      "label": "A provider status other than \"SUCCESS\" becomes ConnectionStatus.FAILURE",
      "testMethod": "test_non_success_status_maps_to_failure"
    },
    {
      "id": "adapters-implement-the-interface",
      "label": "Both adapters are CloudAdapter implementations and CloudAdapter itself is abstract",
      "testMethod": "test_adapters_implement_the_interface"
    },
    {
      "id": "service-rejects-unknown-user-without-calling-provider",
      "label": "Unknown user raises UserNotFoundException(\"User not found\") and the provider is never called",
      "testMethod": "test_service_rejects_unknown_user_without_calling_provider"
    },
    {
      "id": "service-delegates-to-injected-adapter",
      "label": "A valid user is delegated to the injected adapter and its Connection is returned",
      "testMethod": "test_service_delegates_to_injected_adapter"
    },
    {
      "id": "controller-success-response",
      "label": "Controller fills connection_id, connection_status and SUCCESS",
      "testMethod": "test_controller_success_response"
    },
    {
      "id": "controller-failure-response",
      "label": "Controller returns FAILURE with no connection for an unknown user",
      "testMethod": "test_controller_failure_response"
    },
    {
      "id": "controller-does-not-swallow-other-errors",
      "label": "Controller only translates UserNotFoundException",
      "testMethod": "test_controller_does_not_swallow_other_errors"
    },
    {
      "id": "provider-is-a-wiring-decision",
      "label": "The same service works with either provider adapter",
      "testMethod": "test_provider_is_a_wiring_decision"
    }
  ]
