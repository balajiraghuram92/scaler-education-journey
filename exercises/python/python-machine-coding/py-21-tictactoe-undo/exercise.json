    {
      "id": "undo-with-no-moves-raises",
      "label": "Undo on a game with no moves raises EmptyMovesException",
      "testMethod": "test_undo_with_no_moves_raises"
    },
    {
      "id": "undo-empties-the-cell-and-pops-the-move",
      "label": "Undo empties the last cell, clears its player and removes the move from the log",
      "testMethod": "test_undo_empties_the_cell_and_pops_the_move"
    },
    {
      "id": "undo-gives-the-turn-back",
      "label": "The turn goes back to the player who made the undone move",
      "testMethod": "test_undo_gives_the_turn_back"
    },
    {
      "id": "undo-after-win-resumes-game",
      "label": "Undoing the winning move returns the game to IN_PROGRESS with no winner",
      "testMethod": "test_undo_after_win_resumes_game"
    },
    {
      "id": "undo-after-draw-resumes-game",
      "label": "Undoing the last move of a draw returns the game to IN_PROGRESS",
      "testMethod": "test_undo_after_draw_resumes_game"
    },
    {
      "id": "undone-move-does-not-count-towards-a-win",
      "label": "A move that was undone no longer counts towards a row, so it cannot cause a false win",
      "testMethod": "test_undone_move_does_not_count_towards_a_win"
    },
    {
      "id": "handle-undo-decrements-counters",
      "label": "handle_undo decrements the row, column and both diagonal counters of the move",
      "testMethod": "test_handle_undo_decrements_counters"
    },
    {
      "id": "undo-everything-then-replay",
      "label": "Undoing every move restores an empty board that can be replayed to a win",
      "testMethod": "test_undo_everything_then_replay"
    },
    {
      "id": "controller-delegates-undo",
