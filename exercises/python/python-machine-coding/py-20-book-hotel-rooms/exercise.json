      "label": "The booking maps real Room objects to the requested counts",
      "testMethod": "test_booking_contains_real_room_objects"
    },
    {
      "id": "second-booking-reuses-active-session",
      "label": "A later booking by the same user reuses the active session",
      "testMethod": "test_second_booking_reuses_active_session"
    },
    {
      "id": "ended-session-is-not-reused",
      "label": "An ENDED session is not reused: a new ACTIVE one is created",
      "testMethod": "test_ended_session_is_not_reused"
    },
    {
      "id": "sessions-are-per-user",
      "label": "Different users get different sessions",
      "testMethod": "test_sessions_are_per_user"
    },
    {
      "id": "unknown-user-raises-and-stores-nothing",
      "label": "Unknown user raises UserNotFoundException and stores nothing",
      "testMethod": "test_unknown_user_raises_and_stores_nothing"
    },
    {
      "id": "invalid-room-is-atomic",
      "label": "One invalid room id raises InvalidRoomException and leaves no session or booking",
      "testMethod": "test_invalid_room_is_atomic"
    },
