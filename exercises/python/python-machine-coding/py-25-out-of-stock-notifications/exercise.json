  "evidence": [
    {
      "id": "register-creates-pending-notification",
      "label": "Registering for an out-of-stock product creates a PENDING notification",
      "testMethod": "test_register_creates_pending_notification"
    },
    {
      "id": "register-validation",
      "label": "Unknown user, product without inventory and in-stock product raise the matching errors",
      "testMethod": "test_register_validation"
    },
    {
      "id": "reregistering-resets-to-pending-without-duplicate",
      "label": "Registering again resets the existing notification to PENDING without a duplicate",
      "testMethod": "test_reregistering_resets_to_pending_without_duplicate"
    },
    {
      "id": "unregister-deletes-or-raises",
      "label": "Unregistering deletes the notification, or raises NotificationNotFoundError",
      "testMethod": "test_unregister_deletes_or_raises"
    },
    {
      "id": "restock-emails-pending-users-and-marks-sent",
      "label": "Restocking updates the quantity, emails each user with a PENDING notification and marks it SENT",
      "testMethod": "test_restock_emails_pending_users_and_marks_sent"
    },
    {
      "id": "restock-ignores-other-products-and-sent-notifications",
      "label": "Only PENDING notifications of the restocked product are emailed",
      "testMethod": "test_restock_ignores_other_products_and_sent_notifications"
    },
    {
      "id": "restock-creates-missing-inventory-and-rejects-unknown-product",
      "label": "Restocking a product without inventory creates it; an unknown product raises ProductNotFoundError",
      "testMethod": "test_restock_creates_missing_inventory_and_rejects_unknown_product"
    },
    {
      "id": "email-service-builds-subject-and-body",
      "label": "The email goes to the address of the user with a subject and body naming the product and the user",
      "testMethod": "test_email_service_builds_subject_and_body"
    },
    {
      "id": "email-adapter-delegates-to-sendgrid",
      "label": "EmailAdapterImpl is an EmailAdapter that returns what sendgrid.send_email returns",
      "testMethod": "test_email_adapter_delegates_to_sendgrid"
    },
    {
      "id": "controllers-translate-results",
      "label": "Controllers return SUCCESS with the notification id, or FAILURE without raising",
      "testMethod": "test_controllers_translate_results"
    }
  ]
}
