  "evidence": [
    {
      "id": "users-get-consecutive-positions-in-order",
      "label": "Customers who join get positions 1, 2, 3 in insertion order",
      "testMethod": "test_users_get_consecutive_positions_in_order"
    },
    {
      "id": "adding-twice-returns-existing-position",
      "label": "Adding a user who is already waiting returns the existing position without a duplicate",
      "testMethod": "test_adding_twice_returns_existing_position"
    },
    {
      "id": "unknown-user-cannot-join-or-query",
      "label": "An unknown user raises UserNotFoundException(\"User not found\") for add and lookup",
      "testMethod": "test_unknown_user_cannot_join_or_query"
    },
    {
      "id": "position-of-user-not-waiting-is-minus-one",
      "label": "A registered user who is not waiting has position -1",
      "testMethod": "test_position_of_user_not_waiting_is_minus_one"
    },
    {
      "id": "admin-removes-from-the-front",
      "label": "An admin removes the requested number of customers from the front and positions shift",
      "testMethod": "test_admin_removes_from_the_front"
    },
    {
      "id": "removing-more-than-the-list-empties-it",
      "label": "Removing more than the list length removes everyone",
      "testMethod": "test_removing_more_than_the_list_empties_it"
    },
    {
      "id": "non-admin-is-denied",
      "label": "A non-admin gets UnauthorizedAccessException(\"Access Denied\") and nothing is removed",
      "testMethod": "test_non_admin_is_denied"
    },
    {
      "id": "update-unknown-user",
      "label": "Update with an unknown user raises UserNotFoundException",
      "testMethod": "test_update_unknown_user"
    },
    {
      "id": "controller-success-responses",
      "label": "Controller returns SUCCESS with positions for add, get and update",
      "testMethod": "test_controller_success_responses"
    },
    {
      "id": "controller-never-raises",
      "label": "Controller returns FAILURE with position 0 instead of raising",
      "testMethod": "test_controller_never_raises"
    },
    {
      "id": "wait-list-repository-keeps-order",
      "label": "The repository keeps insertion order, assigns ids and deletes entries",
      "testMethod": "test_wait_list_repository_keeps_order"
    }
  ]
}
