  "evidence": [
    {
      "id": "ticket-is-issued-at-an-entry-gate",
      "label": "A ticket records the vehicle, spot, gate, attendant and entry time and marks the spot OCCUPIED",
      "testMethod": "test_ticket_is_issued_at_an_entry_gate"
    },
    {
      "id": "exit-or-unknown-gate-is-rejected",
      "label": "An exit gate or unknown gate raises InvalidGateException and issues nothing",
      "testMethod": "test_exit_or_unknown_gate_is_rejected"
    },
    {
      "id": "vehicle-is-found-or-created",
      "label": "A new vehicle is created once and an existing registration is reused",
      "testMethod": "test_vehicle_is_found_or_created"
    },
    {
      "id": "floor-with-fewest-available-spots-is-chosen",
      "label": "The floor with the fewest available spots of the type is chosen",
      "testMethod": "test_floor_with_fewest_available_spots_is_chosen"
    },
    {
      "id": "tie-goes-to-lowest-floor-and-nearest-spot",
      "label": "A tie goes to the lowest floor number and the lowest-numbered spot",
      "testMethod": "test_tie_goes_to_lowest_floor_and_nearest_spot"
    },
    {
      "id": "non-operational-floors-and-other-types-are-ignored",
      "label": "Floors under maintenance, occupied spots and spots of another type are never assigned",
      "testMethod": "test_non_operational_floors_and_other_types_are_ignored"
    },
    {
      "id": "no-spot-available-issues-no-ticket",
      "label": "No available spot raises ParkingSpotNotAvailableException and stores no ticket",
      "testMethod": "test_no_spot_available_issues_no_ticket"
    },
    {
      "id": "vehicle-type-string-is-parsed",
      "label": "Vehicle type strings are parsed and an invalid one raises ValueError",
      "testMethod": "test_vehicle_type_string_is_parsed"
    },
    {
      "id": "controller-success-and-failures",
      "label": "Controller returns SUCCESS with the ticket, and FAILURE with ticket=None for every error",
      "testMethod": "test_controller_success_and_failures"
    },
    {
      "id": "strategy-marks-each-assigned-spot-occupied",
      "label": "The strategy marks spots OCCUPIED so consecutive calls hand out different spots",
      "testMethod": "test_strategy_marks_each_assigned_spot_occupied"
    }
  ]
}
