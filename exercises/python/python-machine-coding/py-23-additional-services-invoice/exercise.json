  "evidence": [
    {
      "id": "ticket-stores-parsed-additional-services",
      "label": "A ticket stores the requested additional services as AdditionalService values",
      "testMethod": "test_ticket_stores_parsed_additional_services"
    },
    {
      "id": "unsupported-service-for-vehicle-issues-no-ticket",
      "label": "A service the vehicle type does not support raises and issues no ticket or spot",
      "testMethod": "test_unsupported_service_for_vehicle_issues_no_ticket"
    },
    {
      "id": "unknown-service-name-is-rejected",
      "label": "An unknown service name raises UnsupportedAdditionalService",
      "testMethod": "test_unknown_service_name_is_rejected"
    },
    {
      "id": "gate-and-ticket-validation-on-invoice",
      "label": "Invoices need an existing ticket and an EXIT gate; tickets need an ENTRY gate",
      "testMethod": "test_gate_and_ticket_validation_on_invoice"
    },
    {
      "id": "weekday-pricing-rounds-up-hours",
      "label": "Weekday pricing is 10 per started hour",
      "testMethod": "test_weekday_pricing_rounds_up_hours"
    },
    {
      "id": "weekend-slab-pricing-for-cars",
      "label": "Weekend car slabs give 20, 70, 140 and 230 for 1, 3, 5 and 7 hours",
      "testMethod": "test_weekend_slab_pricing_for_cars"
    },
    {
      "id": "weekend-slabs-are-per-vehicle-type",
      "label": "Slabs are looked up per vehicle type, with no slabs meaning no charge",
      "testMethod": "test_weekend_slabs_are_per_vehicle_type"
    },
    {
      "id": "invoice-adds-service-fees-to-parking-fee",
      "label": "The invoice amount is the parking fee plus the additional services' fees",
      "testMethod": "test_invoice_adds_service_fees_to_parking_fee"
    },
    {
      "id": "invoice-frees-the-spot-and-is-saved",
      "label": "The invoice stores the exit time, is saved and frees the parking spot",
      "testMethod": "test_invoice_frees_the_spot_and_is_saved"
    },
    {
      "id": "pricing-strategy-follows-exit-day",
      "label": "Weekday exits use flat pricing and Saturday/Sunday exits use slabs",
      "testMethod": "test_pricing_strategy_follows_exit_day"
    },
    {
      "id": "controllers-translate-errors",
      "label": "Ticket and invoice controllers return SUCCESS or FAILURE",
      "testMethod": "test_controllers_translate_errors"
    }
  ]
}
