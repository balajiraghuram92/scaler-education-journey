  "evidence": [
    {
      "id": "paytm-adapter-maps-response",
      "label": "PaytmPaymentGatewayAdapter calls PaytmApi and builds a domain Payment",
      "testMethod": "test_paytm_adapter_maps_response"
    },
    {
      "id": "razorpay-adapter-maps-response",
      "label": "RazorpayPaymentGatewayAdapter calls process_payment and maps transaction_id to txn_id",
      "testMethod": "test_razorpay_adapter_maps_response"
    },
    {
      "id": "failure-status-is-mapped-to-enum",
      "label": "A \"FAILURE\" status string becomes PaymentStatus.FAILURE in both adapters",
      "testMethod": "test_failure_status_is_mapped_to_enum"
    },
    {
      "id": "adapters-implement-the-interface",
      "label": "Both adapters are PaymentGatewayAdapters and the interface itself is abstract",
      "testMethod": "test_adapters_implement_the_interface"
    },
    {
      "id": "service-rejects-invalid-bill-without-charging",
      "label": "An unknown bill raises InvalidBillException(\"Invalid bill id\") and the gateway is never called",
      "testMethod": "test_service_rejects_invalid_bill_without_charging"
    },
    {
      "id": "service-charges-total-plus-gst-plus-service-charge",
      "label": "The gateway is charged total + GST + service charge for the bill",
      "testMethod": "test_service_charges_total_plus_gst_plus_service_charge"
    },
    {
      "id": "gateway-is-a-one-line-wiring-change",
      "label": "The same service works with either adapter and returns that gateway's transaction",
      "testMethod": "test_gateway_is_a_one_line_wiring_change"
    },
    {
      "id": "controller-success-response",
      "label": "Controller returns SUCCESS with txn_id and payment_status",
      "testMethod": "test_controller_success_response"
    },
    {
      "id": "controller-invalid-bill-response",
      "label": "Controller returns FAILURE with txn_id and payment_status set to None",
      "testMethod": "test_controller_invalid_bill_response"
    },
    {
      "id": "controller-only-catches-invalid-bill",
      "label": "Controller does not swallow other errors",
      "testMethod": "test_controller_only_catches_invalid_bill"
    }
  ]
}
