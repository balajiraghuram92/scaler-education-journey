      "testMethod": "testAddMember_Success"
    },
    {
      "id": "remove-member-unknown-group",
      "label": "Removing a member from a group id that does not exist returns FAILURE",
      "testMethod": "testRemoveMember_GroupNotFound"
    },
    {
      "id": "remove-member-non-admin",
      "label": "Only an admin of the group can remove a member",
      "testMethod": "testRemoveMember_AdminNotFound"
    },
    {
      "id": "remove-member-unknown-user",
      "label": "Removing a user id that does not exist returns FAILURE",
      "testMethod": "testRemoveMember_MemberNotFound"
    },
    {
      "id": "remove-member-not-in-group",
      "label": "Removing a valid user who is not in the group returns FAILURE",
      "testMethod": "testRemoveMember_MemberNotPresentInGroup"
    },
    {
      "id": "remove-member-success",
      "label": "An admin can remove an existing member",
      "testMethod": "testRemoveMember_Success"
    },
    {
      "id": "fetch-members-unknown-group",
      "label": "Listing members of a group id that does not exist returns FAILURE",
      "testMethod": "testFetchMembers_GroupNotFound"
    },
    {
      "id": "fetch-members-unknown-user",
      "label": "Listing members on behalf of a user id that does not exist returns FAILURE",
      "testMethod": "testFetchMembers_MemberNotFound"
    },
    {
      "id": "fetch-members-outsider",
      "label": "A user who is neither an admin nor a member of the group cannot list its members",
