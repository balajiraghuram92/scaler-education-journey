  "testSuite": {
    "visible": false,
    "path": "tests/src/test/java/com/example/bmsbookticket/controllers/TestTicketController.java",
    "className": "TestTicketController"
  },
  "evidence": [
    {
      "id": "book-two-seats",
      "label": "Booking two available seats returns an UNPAID ticket with both seats and marks exactly those seats BLOCKED",
      "testMethod": "testBookTicket_1_Request_Success"
    },
    {
      "id": "book-non-overlapping",
      "label": "Two bookings for disjoint seats of the same show both succeed",
      "testMethod": "testBookTicket_2_Request_Success_Non_overlapping_seats"
    },
    {
      "id": "unknown-user",
      "label": "A booking for a user id that does not exist returns FAILURE and changes no seat",
      "testMethod": "testBookTicket_NonExistingUser_Failure"
    },
    {
      "id": "unknown-show-seat",
      "label": "A request containing a show-seat id that does not exist returns FAILURE and blocks nothing",
      "testMethod": "testBookTicket_InvalidShowSeat_Failure"
    },
    {
      "id": "rebook-blocked-seats",
      "label": "Requesting seats that are already blocked returns FAILURE",
      "testMethod": "testBookTicket_BookABookedTicket_Failure"
    },
    {
      "id": "all-or-nothing",
      "label": "If any requested seat is unavailable, the available ones in the same request stay AVAILABLE",
      "testMethod": "testBookTicket_PartiallyAvailableSeats_Failure"
    },
    {
      "id": "unavailable-ids-reported",
      "label": "The failure names exactly the show-seat ids that were unavailable",
      "testMethod": "testBookTicket_ReportsUnavailableSeatIds"
    },
    {
      "id": "concurrent-requests",
      "label": "When eight requests race for the same two seats, exactly one succeeds and exactly one ticket exists",
      "testMethod": "testBookTicket_ConcurrentRequests_OnlyOneSucceeds"
    }
  ]
}
