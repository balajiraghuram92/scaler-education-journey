      "testMethod": "testIssueTicketWith1AvailableParkingSpot"
    },
    {
      "id": "issue-ticket-two-available-spots",
      "label": "Issues ticket successfully allocating available spot when multiple spots exist",
      "testMethod": "testIssueTicketWith2AvailableParkingSpots"
    },
    {
      "id": "issue-ticket-no-available-spots",
      "label": "Rejects ticket generation with FAILURE when no parking spot is available",
      "testMethod": "testIssueTicketWithNoAvailableSpots"
    },
    {
      "id": "issue-ticket-from-exit-gate",
      "label": "Rejects ticket generation with FAILURE when attempted from an exit gate",
      "testMethod": "testIssueTicketWithFromExitGate"
    },
    {
      "id": "issue-ticket-non-existing-gate",
      "label": "Rejects ticket generation with FAILURE when gate id does not exist",
      "testMethod": "testIssueTicketFromNonExistingGate"
    },
    {
      "id": "issue-ticket-multi-floor-distribution",
      "label": "Correctly evaluates multi-floor capacity and assigns nearest available spot across floors",
      "testMethod": "testIssueTicketWith3Floors2CarsOn1stAnd2ndFloorAnd1On3rdFloor"
    },
    {
      "id": "issue-ticket-floor-under-maintenance",
      "label": "Skips parking spots on floors currently under maintenance",
      "testMethod": "testIssueWithWith1FloorUnderMaintenance"
    }
