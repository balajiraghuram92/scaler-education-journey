# Store the real version as /etc/studytracker/api.env with mode 0600.
# Never commit real values.
POSTGRES_DB=studytracker
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=replace-with-a-strong-generated-password
DATABASE_HOST=studytracker-postgres
DATABASE_PORT=5432
DATABASE_NAME=studytracker
DATABASE_USER=studyuser
DATABASE_PASSWORD=replace-with-the-same-postgres-password
API_KEY=replace-with-a-strong-generated-server-side-proxy-key
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# The deployment script supplies ExerciseExecution__RunnerImage from the
# immutable RUNNER_REF for each release. Keep the cache named and persistent.
ExerciseExecution__MavenCacheVolume=neuralascent-maven-cache
ExerciseExecution__MaxConcurrentExecutions=1
