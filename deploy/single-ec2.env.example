# Store the real version as /etc/studytracker/api.env with mode 0600.
# Never commit real values.
POSTGRES_DB=studytracker
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=replace-with-a-strong-generated-password
DATABASE_HOST=studytracker-postgres
DATABASE_PORT=5432
DATABASE_NAME=studytracker
DATABASE_USER=studyuser
DATABASE_PASSWORD=replace-with-the-same-postgres-password
API_KEY=replace-with-a-strong-generated-server-side-proxy-key
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# The deployment script supplies ExerciseExecution__RunnerImage from the
# immutable RUNNER_REF for each release. Keep the cache named and persistent.
ExerciseExecution__MavenCacheVolume=neuralascent-maven-cache
ExerciseExecution__MaxConcurrentExecutions=1

# The .NET API and ai-agent must share this key (32+ bytes); the deploy script
# passes it to ai-agent as JWT_SIGNING_KEY.
Auth__JwtSigningKey=replace-with-32-plus-random-bytes

# ai-agent reads DATABASE_HOST/PORT/NAME/USER/PASSWORD above (any characters are
# safe in DATABASE_PASSWORD). DATABASE_URL is an alternative that wins if set;
# its password must be percent-encoded. Never quote values: docker --env-file
# keeps the quotes.
MUSE_AI_API_KEY=replace-with-muse-api-key
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional until RAG ingestion starts.
DEEPINFRA_API_KEY=replace-with-deepinfra-api-key
