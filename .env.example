POSTGRES_DB=studytracker
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=your_secure_password_here
API_KEY=your_api_key_here
ASPNETCORE_ENVIRONMENT=Production
IMAGE_API=ghcr.io/balajiraghuram92/scaler-education-journey-api
IMAGE_APP=ghcr.io/balajiraghuram92/scaler-education-journey-app
IMAGE_AI_AGENT=ghcr.io/balajiraghuram92/scaler-education-journey-ai-agent
IMAGE_TAG=latest
DOMAIN_NAME=localhost
EXERCISE_RUNNER_IMAGE=neuralascent-java-runner:dev
EXERCISE_MAVEN_CACHE_VOLUME=neuralascent-maven-cache
# Only needed on rootless-Podman hosts (e.g. local WSL2 dev). Leave unset/default on real Docker hosts (e.g. EC2).
EXERCISE_DOCKER_SOCKET_PATH=/var/run/docker.sock
EXERCISE_DOCKER_SOCKET_GID=0
ADMIN_EMAIL=admin@neuralascent.local 
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SIGNING_KEY=your_jwt_signing_key_32_bytes_base64_here
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_32_bytes_base64_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_FROM=noreply@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
SMTP_PASS=your_smtp_password
LLAMA_API_KEY=your_llama_api_key_here 
MUSE_AI_API_KEY=your_meta_muse_api_key_here
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
DATABASE_URL=provide_your_db_url