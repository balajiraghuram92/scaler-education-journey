# Per-IP request limit for the tutor host (paid LLM calls). ai-agent also
# applies its own per-user limit; this is the coarse outer layer.
limit_req_zone $binary_remote_addr zone=tutor_per_ip:10m rate=5r/s;

# 1. Redirect all HTTP traffic to HTTPS
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Main HTTPS Server
server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};

    # Dynamic SSL Certificate Paths (Mounted from EC2 host)
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # SSL Protocols & Performance Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 256;

    # SPA client-side fallback routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to .NET 8 backend API container
    location /api {
        proxy_pass http://studytracker-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header x-api-key "${API_KEY}";
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
    }
}

# 3. Redirect HTTP traffic for tutor subdomain to HTTPS
server {
    listen 80;
    server_name tutor.${DOMAIN_NAME};

    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 4. AI Agent (Tutor) HTTPS Server
server {
    listen 443 ssl;
    server_name tutor.${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    limit_req zone=tutor_per_ip burst=20 nodelay;
    limit_req_status 429;
    client_max_body_size 1m;

    # Resolve ai-agent per request via Docker's embedded DNS, so nginx still
    # starts (and the main site stays up) when the ai-agent container is absent.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $ai_agent_upstream http://ai-agent:8000;

    location / {
        proxy_pass $ai_agent_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Real FastAPI liveness (502 when ai-agent is down), not a fixed 200.
    location = /health {
        access_log off;
        proxy_pass $ai_agent_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 5s;
    }
}
